import tkinter as tk
from tkinter import messagebox


meals = []


def analyze_calories():


   total = 0
   for meal in meals:                # Iteration
       total += meal["calories"]


   if total == 0:
       classification = "No data entered"
   elif total < 500:
       classification = "Low intake"
   elif total < 1500:
       classification = "Moderate intake"
   else:
       classification = "High intake"


   return total, classification


def add_meal():
   meal_name = meal_entry.get()
   calorie_text = calorie_entry.get()


   if meal_name.strip() == "" or calorie_text.strip() == "":
       messagebox.showerror("Error", "Please enter both a meal name and calories.")
       return


   try:
       calories = int(calorie_text)
       if calories < 0:
           raise ValueError
   except ValueError:
       messagebox.showerror("Error", "Calories must be a positive whole number.")
       return


   meals.append({"meal": meal_name, "calories": calories})


   meal_list.insert(tk.END, f"{meal_name} — {calories} calories")


   meal_entry.delete(0, tk.END)
   calorie_entry.delete(0, tk.END)


   update_summary()




def update_summary():
   total, classification = analyze_calories()
   summary_label.config(text=f"Total Calories: {total}\nHealth Classification: {classification}")


root = tk.Tk()
root.title("Meal Calorie Calculator")


tk.Label(root, text="Meal Calorie Calculator", font=("Arial", 16, "bold")).pack(pady=10)


input_frame = tk.Frame(root)
input_frame.pack(pady=5)


tk.Label(input_frame, text="Meal:").grid(row=0, column=0, padx=5, pady=5)
meal_entry = tk.Entry(input_frame, width=30)
meal_entry.grid(row=0, column=1)


tk.Label(input_frame, text="Calories:").grid(row=1, column=0, padx=5, pady=5)
calorie_entry = tk.Entry(input_frame, width=30)
calorie_entry.grid(row=1, column=1)


tk.Button(root, text="Add Meal", command=add_meal).pack(pady=10)


list_frame = tk.Frame(root)
list_frame.pack(pady=10)


scrollbar = tk.Scrollbar(list_frame)
scrollbar.pack(side=tk.RIGHT, fill=tk.Y)


meal_list = tk.Listbox(list_frame, width=45, height=10, yscrollcommand=scrollbar.set)
meal_list.pack(side=tk.LEFT)


scrollbar.config(command=meal_list.yview)


summary_label = tk.Label(root, text="Total Calories: 0\nHealth Classification: No data", font=("Arial", 12))
summary_label.pack(pady=15)


root.mainloop()
